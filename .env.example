# ============================================================================
# StreamForge 24/7 — Environment Variables (Vercel / Local)
# ============================================================================
# You can either set these in Vercel Project Settings -> Environment Variables
# OR enter them directly inside the Web Dashboard UI ("GitHub Token & Repo" button)!

GITHUB_OWNER=your-github-username
GITHUB_REPO=live-tv-stream-engine
GITHUB_BRANCH=main
GITHUB_TOKEN=ghp_your_personal_access_token_with_repo_and_workflow_scopes
STREAM_API_SECRET=streamforge-24x7
